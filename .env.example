# Bu dosyayı kopyala → .env olarak kaydet (setup_ortam.bat otomatik yapar)
# Sonra Notepad ile aç ve aşağıdaki değerleri doldur.

# ── OpenAI API Anahtarı ───────────────────────────────────────
# platform.openai.com > API Keys > Create new secret key
OPENAI_API_KEY=sk-...buraya_openai_api_anahtarini_yaz...

# ── Fine-tune Model ID ────────────────────────────────────────
# Adım 3 tamamlanınca buraya model ID otomatik yazılır.
# Örnek: ft:gpt-4o-mini-2024-07-18:org:autocad-degerlendirme:AbCdEfGh
FINETUNED_MODEL_ID=

# ── Google Drive Klasörü ──────────────────────────────────────
# Drive'dan indirdiğin klasörün TAM YOLU
# Windows örneği: C:\Users\Dilara\Desktop\autocad_drive
# Not: Ters slash (\) kullan, eğik slash (/) değil
DRIVE_DATA_PATH=C:\Users\KULLANICI_ADIN\Desktop\autocad_drive

# ── Port (isteğe bağlı) ───────────────────────────────────────
# 5000 başka program tarafından kullanılıyorsa değiştir
# PORT=5001
