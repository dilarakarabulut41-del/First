# Bu dosyayı kopyala: cp .env.example .env
# Sonra .env içindeki değerleri doldur

# OpenAI API anahtarı (platform.openai.com > API Keys)
OPENAI_API_KEY=sk-...buraya_openai_api_anahtarini_yaz...

# Fine-tune tamamlandıktan sonra buraya model ID gelecek
# Örnek: ft:gpt-4o-mini-2024-07-18:org:autocad:AbCdEfGh
FINETUNED_MODEL_ID=

# Veri klasörü yolu (Drive'dan indirdiğin klasör)
DRIVE_DATA_PATH=/Users/senin_adin/Desktop/autocad_drive
